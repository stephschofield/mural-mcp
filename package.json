{
  "name": "mural-mcp",
  "version": "2.1.0",
  "description": "Read-only Model Context Protocol server for the Mural public API. Read boards, sticky notes, images, and stickers from Copilot CLI, VS Code Copilot Chat, or Claude.",
  "main": "build/index.js",
  "type": "module",
  "bin": {
    "mural-mcp": "build/index.js"
  },
  "scripts": {
    "build": "tsc && node scripts/make-executable.mjs",
    "auth": "node build/auth-cli.js",
    "start": "node build/index.js",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test build/widgets.test.js scripts/*.test.mjs && node scripts/verify-mcp.mjs",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "mural",
    "model-context-protocol",
    "claude",
    "claude-code",
    "github-copilot",
    "vscode",
    "miro-alternative",
    "whiteboard",
    "oauth",
    "read-only",
    "ai-agent"
  ],
  "author": "Steph Schofield",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stephschofield/mural-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/stephschofield/mural-mcp/issues"
  },
  "homepage": "https://github.com/stephschofield/mural-mcp#readme",
  "files": [
    "build/",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    ".env.example"
  ]
}

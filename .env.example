# Mural OAuth app credentials — from https://app.mural.co → "Create and manage apps"
# Copy to .env and fill in, OR export these in your shell profile.
# The client secret is shown only once at app creation.

MURAL_CLIENT_ID=your_client_id_here
MURAL_CLIENT_SECRET=your_client_secret_here

# Must match the Redirect URL registered on the Mural app exactly.
MURAL_REDIRECT_URI=http://localhost:3000/callback

# Where the OAuth token cache is written (chmod 0600).
# Defaults to ~/.mural-mcp/tokens.json
# MURAL_TOKEN_PATH=/custom/path/tokens.json

# ── Dependencies & build output ──────────────────────────────────────────────
node_modules/
build/
dist/
*.tsbuildinfo

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Credentials & OAuth tokens — NEVER COMMIT ────────────────────────────────
# The client secret is shown once by Mural and grants API access on your behalf.
# The token cache holds a live access token and a long-lived refresh token.
.env
.env.*
!.env.example
tokens.json
*.tokens.json
.mural-mcp/
secrets.json
credentials.json
*.pem
*.key
*.p12
*.pfx

# ── Editor / OS noise ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# ── Local agent / tooling state ──────────────────────────────────────────────
.claude/worktrees/
showoff-output/
